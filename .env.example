# Optional: Required only for user-enrolled ElevenLabs voice clones.
ELEVENLABS_API_KEY=""

# Runpod Serverless endpoint IDs from your Runpod console. These are endpoint IDs,
# not model names or endpoint display names.
RUNPOD_API_KEY="rpa_YOUR_RUNPOD_API_KEY_HERE"
PUBLIC_BASE_URL="https://office.creativeprocess.io/videolab"
RUNPOD_BASE_URL="https://api.runpod.ai/v2"
RUNPOD_INFINITETALK_ENDPOINT=""
RUNPOD_PVIDEO_ENDPOINT=""
RUNPOD_CHATTERBOX_ENDPOINT=""
RUNPOD_MUSETALK_ENDPOINT=""
RUNPOD_ZIMAGE_ENDPOINT=""

# MiniMax-H3 uses the private SSH tunnel managed by ops/minimax/connect.sh.
MINIMAX_BASE_URL="http://127.0.0.1:30011"
MINIMAX_HOURLY_USD=0.27
MINIMAX_MAX_JOB_SECONDS=7200
# Enable only after approving the first paid end-to-end validation.
MINIMAX_GENERATION_ENABLED=false
# Optional for an authenticated external HTTPS deployment; keep out of the browser.
MINIMAX_API_KEY=""

# Studio lip-sync: a MuseTalk 1.5 Runpod queue worker, minimum workers 0.
# Enable only after a real GPU validation. No endpoint is created by this config.
MUSETALK_GENERATION_ENABLED=false
MUSETALK_HOURLY_USD=0.58
MUSETALK_MAX_JOB_SECONDS=600
MUSETALK_STARTUP_ALLOWANCE_SECONDS=300
CHATTERBOX_HOURLY_USD=0.58
RUNPOD_BILLING_GUARD_ENABLED=true
# Optional stable signing secret for worker uploads. Falls back to RUNPOD_API_KEY.
# Keep private on the app server; the worker receives only a job-specific token.
MUSETALK_CALLBACK_SECRET=""

# Spend guardrails in USD.
DAILY_SPEND_CAP_USD=5.00
MONTHLY_SPEND_CAP_USD=50.00

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Runpod script writing and image analysis (OpenAI-compatible endpoints).
RUNPOD_TEXT_ENDPOINT=""
RUNPOD_TEXT_MODEL=Qwen/Qwen3-32B-AWQ
RUNPOD_VISION_ENDPOINT=""
RUNPOD_VISION_MODEL=kimi-k2.6
# Update these rates when changing models; used for budget reservations/reconciliation.
RUNPOD_TEXT_USD_PER_MILLION_TOKENS=10.00
RUNPOD_VISION_INPUT_USD_PER_MILLION_TOKENS=0.95
RUNPOD_VISION_OUTPUT_USD_PER_MILLION_TOKENS=4.00

# Optional GPT-backed script and avatar-prompt enhancement.
# Add the real key to the server's private .env file, never to the browser.
OPENAI_API_KEY=""
OPENAI_MODEL=gpt-4o-mini
OPENAI_INPUT_USD_PER_MILLION_TOKENS=0.15
OPENAI_OUTPUT_USD_PER_MILLION_TOKENS=0.60
